encodeRows : ∀ {n} → F.Vec Row n → F.Vec ℕ n
encodeRows F.[] = F.[]
encodeRows (row F.∷ rows) = encodeRow row F.∷ encodeRows rows

decodeRows : ∀ {n} → F.Vec ℕ n → F.Vec Row n
decodeRows F.[] = F.[]
decodeRows (n F.∷ ns) = decodeRow n F.∷ decodeRows ns

decode-encodeRows : ∀ {n} (rows : F.Vec Row n) → decodeRows (encodeRows rows) ≡ rows
decode-encodeRows F.[] = refl
decode-encodeRows (row F.∷ rows) rewrite decode-encodeRow row | decode-encodeRows rows = refl

record PackedState : Set where
  constructor packed
  field
    codes : F.Vec ℕ 6
    whose : Player
open PackedState public

encode : State six → PackedState
encode (state b p) = packed (encodeRows b) p

decode : PackedState → State six
decode (packed rows p) = state (decodeRows rows) p

decode-encode : ∀ s → decode (encode s) ≡ s
decode-encode (state b p) = cong (λ c → state c p) (decode-encodeRows b)

map-decode-encode : ∀ ss → map decode (map encode ss) ≡ ss
map-decode-encode [] = refl
map-decode-encode (s ∷ ss) rewrite decode-encode s | map-decode-encode ss = refl

private
  nat-equal-sound : ∀ m n → (m ≡ᵇ n) ≡ true → m ≡ n
  nat-equal-sound zero zero checked = refl
  nat-equal-sound zero (suc n) ()
  nat-equal-sound (suc m) zero ()
  nat-equal-sound (suc m) (suc n) checked = cong suc (nat-equal-sound m n checked)

  left : ∀ a b → a ∧ b ≡ true → a ≡ true
  left true b checked = refl
  left false b ()

  right : ∀ a b → a ∧ b ≡ true → b ≡ true
  right true b checked = checked
  right false b ()

  cong₂ : ∀ {A B C : Set} (f : A → B → C) {a a′ b b′} →
    a ≡ a′ → b ≡ b′ → f a b ≡ f a′ b′
  cong₂ f refl refl = refl

equal : PackedState → PackedState → Bool
equal (packed bs p) (packed cs q) = E.sameVec _≡ᵇ_ bs cs ∧ samePlayer p q

equal-sound : ∀ s t → equal s t ≡ true → s ≡ t
equal-sound (packed bs p) (packed cs q) checked = cong₂ packed
  (E.sameVec-sound _≡ᵇ_ nat-equal-sound bs cs
    (left (E.sameVec _≡ᵇ_ bs cs) (samePlayer p q) checked))
  (E.samePlayer-sound p q (right (E.sameVec _≡ᵇ_ bs cs) (samePlayer p q) checked))

equality : StateEquality PackedState
equality = stateEquality equal equal-sound

matches : State six → PackedState → Bool
matches s t = equal (encode s) t

matches-sound : ∀ s t → matches s t ≡ true → s ≡ decode t
matches-sound s t checked = trans (sym (decode-encode s))
  (cong decode (equal-sound (encode s) t checked))

