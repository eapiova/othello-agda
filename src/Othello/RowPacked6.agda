{-# OPTIONS --safe --without-K --cubical-compatible #-}
-- AI-assisted row codes. The right inverse is checked for all 3^6 rows.
module Othello.RowPacked6 where

open import Prelude
open import Agda.Builtin.Nat using (_+_; _*_; div-helper; mod-helper) renaming (_==_ to _≡ᵇ_)
open import Othello.Board
import Othello.Finite as F
import Othello.Encode6 as E
open import Game.Composite using (StateEquality; stateEquality)

Row : Set
Row = F.Vec Cell 6

private
  code : Cell → ℕ
  code empty = 0
  code blackCell = 1
  code whiteCell = 2

  cell : ℕ → Cell
  cell zero = empty
  cell (suc zero) = blackCell
  cell (suc (suc n)) = whiteCell

  digit : ℕ → ℕ → Cell
  digit n powerMinusOne = cell
    (mod-helper 0 2 (div-helper 0 powerMinusOne n powerMinusOne) 2)

encodeRow : Row → ℕ
encodeRow (a F.∷ b F.∷ c F.∷ d F.∷ e F.∷ f F.∷ F.[]) =
  code a + 3 * (code b + 3 * (code c + 3 * (code d + 3 * (code e + 3 * code f))))

decodeRow : ℕ → Row
decodeRow n = digit n 0 F.∷ digit n 2 F.∷ digit n 8 F.∷
  digit n 26 F.∷ digit n 80 F.∷ digit n 242 F.∷ F.[]

decode-encodeRow : ∀ row → decodeRow (encodeRow row) ≡ row
decode-encodeRow (empty F.∷ empty F.∷ empty F.∷ empty F.∷ empty F.∷ empty F.∷ F.[]) = refl
decode-encodeRow (empty F.∷ empty F.∷ empty F.∷ empty F.∷ empty F.∷ blackCell F.∷ F.[]) = refl
decode-encodeRow (empty F.∷ empty F.∷ empty F.∷ empty F.∷ empty F.∷ whiteCell F.∷ F.[]) = refl
