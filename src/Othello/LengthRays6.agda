{-# OPTIONS --safe --without-K --cubical-compatible #-}
module Othello.LengthRays6 where

open import Prelude
open import Othello.Board using
  ( Player; black; white; Cell; empty; blackCell; whiteCell
  ; Coord; six
  )
import Othello.CellRays6 as Rays

prefix : ℕ → List (Coord six) → List (Coord six)
prefix zero xs = []
prefix (suc n) [] = []
prefix (suc n) (q ∷ qs) = q ∷ prefix n qs

count0 : Player → ℕ
count0 p = 0

count1 : Player → Cell → ℕ
count1 p c1 = 0

count2 : Player → Cell → Cell → ℕ
count2 black whiteCell blackCell = 1
count2 white blackCell whiteCell = 1
count2 p c1 c2 = 0

count3 : Player → Cell → Cell → Cell → ℕ
count3 black whiteCell blackCell _ = 1
count3 black whiteCell whiteCell blackCell = 2
count3 white blackCell whiteCell _ = 1
count3 white blackCell blackCell whiteCell = 2
count3 p c1 c2 c3 = 0

count4 : Player → Cell → Cell → Cell → Cell → ℕ
count4 black whiteCell blackCell _ _ = 1
count4 black whiteCell whiteCell blackCell _ = 2
count4 black whiteCell whiteCell whiteCell blackCell = 3
count4 white blackCell whiteCell _ _ = 1
count4 white blackCell blackCell whiteCell _ = 2
count4 white blackCell blackCell blackCell whiteCell = 3
count4 p c1 c2 c3 c4 = 0

count5 : Player → Cell → Cell → Cell → Cell → Cell → ℕ
count5 black whiteCell blackCell _ _ _ = 1
count5 black whiteCell whiteCell blackCell _ _ = 2
count5 black whiteCell whiteCell whiteCell blackCell _ = 3
count5 black whiteCell whiteCell whiteCell whiteCell blackCell = 4
count5 white blackCell whiteCell _ _ _ = 1
count5 white blackCell blackCell whiteCell _ _ = 2
count5 white blackCell blackCell blackCell whiteCell _ = 3
count5 white blackCell blackCell blackCell blackCell whiteCell = 4
count5 p c1 c2 c3 c4 c5 = 0

